# Скопируйте файл в .env и задайте пароль перед первым запуском.
# Для пароля со знаком $ используйте одинарные кавычки в .env.
POSTGRES_PASSWORD=

POSTGRES_DB=balanceplatform
POSTGRES_USER=balanceplatform
POSTGRES_PORT=5432
APP_PORT=8080
BALANCE_WORKER_POLL_DELAY_MS=1000

# Каталог пакетов на хосте. По умолчанию используется ./data.
# BALANCE_DATASETS_PATH='/путь к каталогу пакетов'
# Необязательный абсолютный путь на хосте к доверенному каталогу check_*.py.
# BALANCE_CHECKS_PATH='/путь к пакету/checks'
BALANCE_PYTHON_TIMEOUT=PT5M
